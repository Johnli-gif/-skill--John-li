# A股云端监控配置模板
# 复制为 /etc/ashare-monitor.env 或项目根目录 .env 后填写真实值。

# 数据源：状态引擎生成的只读状态与已批准决策
TRADING_STATE_PATH=/opt/ashare-monitor/data/trading-state.json
DECISION_LATEST_PATH=/opt/ashare-monitor/data/decision-latest.json
ALERT_STATE_FILE=/opt/ashare-monitor/data/cloud-monitor/state.json
HEARTBEAT_STATE_FILE=/opt/ashare-monitor/data/cloud-monitor/heartbeat.json
HEALTH_NOTICE_STATE_FILE=/opt/ashare-monitor/data/cloud-monitor/health-notice.json

# 交易时段控制：true 表示只在周一至周五 09:25-11:35、12:55-15:05 运行
TRADE_HOURS_ONLY=true

# 同一决策的相同触发重复提醒间隔，单位分钟
QUIET_REPEAT_MINUTES=30
MAX_QUOTE_AGE_MINUTES=5
MAX_SOURCE_PRICE_DIFF_PCT=0.20
HEARTBEAT_MAX_AGE_MINUTES=12

# 微信提醒通道 1：企业微信机器人 webhook
# 创建方式：企业微信群 > 添加机器人 > 复制 webhook
WECHAT_WORK_WEBHOOK_URL=

# 微信提醒通道 2：PushPlus 微信推送
# https://www.pushplus.plus/
# 登录、绑定微信服务号并完成平台要求的认证后填写用户Token；程序固定使用wechat渠道。
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=

# 必填：PushPlus会把异步最终状态回调到该HTTPS收件箱。
# 建议使用40位十六进制随机值，并保持整个主题名不超过64个字符。
PUSHPLUS_CALLBACK_URL=
PUSHPLUS_VERIFY_ATTEMPTS=12
NOTIFICATION_RECEIPT_FILE=/opt/ashare-monitor/data/cloud-monitor/notification-receipt.json
SUMMARY_STATE_FILE=/opt/ashare-monitor/data/cloud-monitor/summary-state.json
