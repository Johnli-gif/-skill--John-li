# A股云端监控配置模板
# 复制为 /etc/ashare-monitor.env 或项目根目录 .env 后填写真实值。

# 数据源：云服务器上的 panel-sync.json 路径
PANEL_SYNC_PATH=/opt/ashare-monitor/data/panel-sync.json
MONITOR_RULES_PATH=/opt/ashare-monitor/config/cloud-monitor-rules.json
ALERT_STATE_FILE=/opt/ashare-monitor/data/cloud-monitor/state.json

# 交易时段控制：true 表示只在周一至周五 09:25-11:35、12:55-15:05 运行
TRADE_HOURS_ONLY=true

# actionable=只提醒买入/卖出触发；watch=观察线也提醒；sell=只提醒风控卖出线
ALERT_MIN_LEVEL=actionable

# 同一批触发条件重复提醒间隔，单位分钟
QUIET_REPEAT_MINUTES=30

# 微信提醒通道 1：企业微信机器人 webhook
# 创建方式：企业微信群 > 添加机器人 > 复制 webhook
WECHAT_WORK_WEBHOOK_URL=

# 微信提醒通道 2：PushPlus 微信推送
# https://www.pushplus.plus/
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=

# 微信提醒通道 3：Server酱
# https://sct.ftqq.com/
SERVERCHAN_SENDKEY=

# 邮件提醒通道
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# 短信提醒通道 A：通用 webhook，适合接入自建网关、企业微信应用或第三方短信平台
SMS_WEBHOOK_URL=

# 短信提醒通道 B：阿里云短信
# 注意：短信签名和模板必须先在阿里云审核通过；模板变量名要与 TEMPLATE_PARAM_JSON 匹配。
SMS_PROVIDER=
SMS_TO=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM_JSON={"message":"{{message}}"}
